# Server
BACKEND_PORT=8000
ENVIRONMENT=development

# Exasol (personal local instance)
EXASOL_ENABLED=true
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
EXASOL_PASSWORD=
# If EXASOL_PASSWORD is empty, password is read from this file (no trailing newline required)
EXASOL_PASSWORD_FILE=~/.exasol-starter-kit/credentials/personal_sys_password

# Redis (sessions + active assessments)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Auth
JWT_SECRET=change-me-in-production
