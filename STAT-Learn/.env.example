# Copy to `.env` in the repo root (same folder as `docker-compose.yml`).
# Never commit `.env`.

# --- LLM (AI path generation + lesson tutor) ---
LLM_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional alternatives (only if you change LLM_PROVIDER):
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Exasol Personal (Local Devjam deployment) ---
# Compose mounts ~/.exasol-starter-kit/credentials/personal_sys_password into the backend.
# You usually do NOT need EXASOL_PASSWORD in .env when that file exists.
EXASOL_ENABLED=true
EXASOL_DSN=host.docker.internal:8563
EXASOL_USER=sys
EXASOL_SCHEMA=MANTHAINO
# EXASOL_PASSWORD=
